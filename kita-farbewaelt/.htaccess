# Kita Farbewält — Apache-Einstellungen (Hostpoint, cyon, Infomaniak …)
DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Immer über HTTPS (erst aktivieren, wenn das SSL-Zertifikat läuft)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Interne Ordner sperren
  RewriteRule ^(data|inc)(/|$) - [F,L]

  # Schöne Adressen: /tarife/ -> index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "^(README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>

AddType font/woff2 .woff2
AddType video/mp4 .mp4
AddType image/webp .webp
AddType image/svg+xml .svg

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType application/pdf "access plus 1 day"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Grössere Uploads (Videos) erlauben – greift nur, wenn der Hoster das zulässt
<IfModule mod_php.c>
  php_value upload_max_filesize 256M
  php_value post_max_size 260M
  php_value max_execution_time 300
</IfModule>
